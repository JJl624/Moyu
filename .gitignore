# Keep the repository limited to source, tests, build inputs and licenses.
/*
!/.github/
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/docs/
/docs/*
!/docs/editor-contracts.md
!/docs/attachment-previews.md
!/docs/document-storage.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/playwright.config.ts
!/src/
!/electron/
!/shared/
!/scripts/
!/tests/
!/resources/
!/public/
!/android/
!/mobile.html
!/start-android.cmd
!/vite.mobile.config.ts

/android/.gradle/
/android/local.properties
/android/emulator.local.json
/android/app/build/
/android/app/build-gecko-*/
/android/app/build-webview/
/android/build/
/android/app/src/main/assets/web/
/android/app/src/main/assets/guides/
/android/app/src/main/assets/examples/
/android/keystore.properties
/android/*.jks
/android/signing/
!/playwright.mobile.config.ts

node_modules/
.runtime-build/
*.log
.DS_Store
.env
.env.*
*.pem
*.key

