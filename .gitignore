# Keep the repository limited to source, tests, build inputs and licenses.
/*
!/.github/
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/playwright.config.ts
!/src/
!/electron/
!/shared/
!/scripts/
!/tests/
!/resources/
!/public/

node_modules/
.runtime-build/
*.log
.DS_Store
.env
.env.*
*.pem
*.key

# Reproduced by the build; runtime bundles are verified Release assets.
/resources/bundled-runtimes/
/resources/clang/bin/
/resources/clang/manifest.json
/resources/clang/runtime-manifest.v1.json
/resources/clang/LICENSES.txt
/resources/clang/THIRD-PARTY-NOTICES.md
/resources/sql/
/resources/lua/
/resources/pyodide/
/resources/terminal/
/resources/formatters/manifest.json
/resources/formatters/ruff.wasm
/resources/formatters/typescript.wasm
/resources/formatters/sql.wasm
/public/excalidraw/fonts/
/public/pdfjs/
/electron/runner/clang-runtime.mjs
/electron/runner/sql-runtime.mjs
/electron/runner/lua-runtime.mjs
